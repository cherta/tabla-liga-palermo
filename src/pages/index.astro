---
const baseUrl = `${import.meta.env.BASE_URL}/`.replace(/\/+$/, '/');
const pageTitle = 'Tablas 2026 | Liga Palermo';
const pageDescription = 'Tablas de posiciones y resultados de las series A y B de Liga Palermo 2026.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(`${baseUrl}og.png`, Astro.site);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="selector-shell">
      <section class="selector-card" aria-labelledby="page-title">
        <p class="eyebrow">Liga Palermo · Temporada 2026</p>
        <h1 id="page-title">¿Qué tabla querés ver?</h1>
        <p class="intro">Elegí una división para consultar la tabla general, las posiciones por categoría y todos los resultados.</p>

        <nav class="division-options" aria-label="Elegir división">
          <a class="serie-a-option" href={`${baseUrl}serie-a/`}>
            <span class="series-letter">A</span>
            <span>
              <strong>Serie A</strong>
              <small>Ver tabla y resultados</small>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="serie-b-option" href={`${baseUrl}serie-b/`}>
            <span class="series-letter">B</span>
            <span>
              <strong>Serie B</strong>
              <small>Ver tabla y resultados</small>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </nav>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background:
      linear-gradient(rgba(11, 79, 138, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(11, 79, 138, 0.04) 1px, transparent 1px),
      linear-gradient(180deg, #f8fbfd 0%, #eaf2f7 100%);
    background-size: 28px 28px, 28px 28px, auto;
    color: #061827;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .selector-shell {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: 1rem;
  }

  .selector-card {
    width: min(100%, 42rem);
    padding: clamp(1.25rem, 5vw, 2.6rem);
    border: 1px solid #123a5c;
    background:
      linear-gradient(135deg, rgba(23, 143, 88, 0.19), transparent 42%),
      linear-gradient(135deg, #062b49, #0b4f8a);
    color: #fff;
    box-shadow: 0 18px 42px rgba(6, 43, 73, 0.18);
  }

  .eyebrow {
    margin: 0;
    color: #8ce6b8;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 33rem;
    margin: 0.4rem 0 0;
    font-size: clamp(2.5rem, 10vw, 4.8rem);
    letter-spacing: -0.065em;
    line-height: 0.95;
  }

  .intro {
    max-width: 32rem;
    margin: 1rem 0 0;
    color: #dbeaf5;
    font-size: 1rem;
    line-height: 1.5;
  }

  .division-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .division-options a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    min-height: 6rem;
    padding: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    text-decoration: none;
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .division-options a:hover,
  .division-options a:focus-visible {
    border-color: #8ce6b8;
    background: rgba(255, 255, 255, 0.16);
    outline: none;
    transform: translateY(-2px);
  }

  .series-letter {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    background: #178f58;
    color: #fff;
    font-size: 1.55rem;
    font-weight: 950;
  }

  .division-options .serie-a-option {
    background: rgba(101, 80, 154, 0.17);
  }

  .serie-a-option .series-letter {
    background: #65509a;
  }

  .division-options .serie-a-option:hover,
  .division-options .serie-a-option:focus-visible {
    border-color: #c8b8ed;
    background: rgba(101, 80, 154, 0.24);
  }

  .division-options strong,
  .division-options small {
    display: block;
  }

  .division-options strong {
    font-size: 1.05rem;
  }

  .division-options small {
    margin-top: 0.18rem;
    color: #dbeaf5;
    font-size: 0.72rem;
  }

  .arrow {
    color: #8ce6b8;
    font-size: 1.35rem;
    font-weight: 900;
  }

  @media (max-width: 34rem) {
    .division-options {
      grid-template-columns: 1fr;
    }
  }
</style>
